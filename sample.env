DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Optional
DHAN_MAX_RETRIES=5
DHAN_AUTH_MAX_RETRIES=5
DHAN_TRADE_HISTORY_SLEEP_SECONDS=1

# Optional — reuse access token (default: false), set to true in development to avoid token expiry issues
DHAN_REUSE_ACCESS_TOKEN=false 

# Optional — trade history date range (YYYY-MM-DD)
# DHAN_TRADE_FROM=2025-01-01
# DHAN_TRADE_TO=2026-08-11

# Neon PostgreSQL — pooled connection string from console.neon.tech
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# If connection hangs, remove &channel_binding=require from the URL.
DATABASE_URL=
