DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Optional - default set
DHAN_MAX_RETRIES=5
DHAN_AUTH_MAX_RETRIES=5
DHAN_TRADE_HISTORY_SLEEP_SECONDS=1

# reuse access token (default: false), set to true in development to avoid token expiry issues
DHAN_REUSE_ACCESS_TOKEN=false 

# Required for first backfill (scripts/backfill_trades.py) — start of trade history (YYYY-MM-DD)
# Daily sync (scripts/daily_sync.py) derives its range from DB; no date env vars needed.
# DHAN_TRADE_FROM=2025-09-01
# DHAN_TRADE_TO=2026-08-11

# Neon PostgreSQL — pooled connection string from console.neon.tech
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# If connection hangs, remove &channel_binding=require from the URL.
DATABASE_URL=
